#============================================================
# End of pin assignments by Terasic System Builder
#============================================================


#============================================================
# CAN IDS/IPS sources (8-byte model; for 5 or 6 bytes use
# ../hdl/generated_p5 or _p6/rf_ids.v and change FEAT_BYTES
# in can_ids_top.v)
#============================================================
set_global_assignment -name VERILOG_FILE can_ids_top.v
set_global_assignment -name VERILOG_FILE ../hdl/can_rx.v
set_global_assignment -name VERILOG_FILE ../hdl/generated_p8/rf_ids.v
set_global_assignment -name VERILOG_FILE ../hdl/known_id.v
set_global_assignment -name VERILOG_FILE ../hdl/ips_flag.v
# Pins the design does not use: inputs, not driven
set_global_assignment -name RESERVE_ALL_UNUSED_PINS_WEAK_PULLUP "AS INPUT TRI-STATED"
set_global_assignment -name NUM_PARALLEL_PROCESSORS ALL
