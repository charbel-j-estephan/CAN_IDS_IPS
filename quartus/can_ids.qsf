# Quartus Prime Lite project for the DE10 Lite (MAX 10 10M50DAF484C7G).
# Open quartus/can_ids.qpf in Quartus, or compile from a terminal with:
#   quartus_sh --flow compile can_ids
set_global_assignment -name FAMILY "MAX 10"
set_global_assignment -name DEVICE 10M50DAF484C7G
set_global_assignment -name TOP_LEVEL_ENTITY rf_ids
set_global_assignment -name VERILOG_FILE ../hdl/generated/rf_ids.v
set_global_assignment -name SDC_FILE can_ids.sdc
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name NUM_PARALLEL_PROCESSORS ALL

# 50 MHz oscillator MAX10_CLK1_50 on the DE10 Lite.
set_location_assignment PIN_P11 -to clk
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to clk

# The frame and result ports connect to on chip logic in the final design
# (CAN controller or MCU link), not to pins. Virtual pins keep Quartus from
# using 80 real I/O pins and keep pin delays out of the Fmax number.
set_instance_assignment -name VIRTUAL_PIN ON -to rst
set_instance_assignment -name VIRTUAL_PIN ON -to in_valid
set_instance_assignment -name VIRTUAL_PIN ON -to can_id[*]
set_instance_assignment -name VIRTUAL_PIN ON -to dlc[*]
set_instance_assignment -name VIRTUAL_PIN ON -to data[*]
set_instance_assignment -name VIRTUAL_PIN ON -to out_valid
set_instance_assignment -name VIRTUAL_PIN ON -to class_out[*]
