#============================================================
# End of pin assignments by Terasic System Builder
#============================================================


#============================================================
# Updatable model sources. Frozen RTL only: the model is data.
#============================================================
set_global_assignment -name VERILOG_FILE ../rtl/top/updatable_top.v
set_global_assignment -name VERILOG_FILE ../rtl/top/updatable_core.v
set_global_assignment -name VERILOG_FILE ../rtl/frontend_can/can_rx.v
set_global_assignment -name VERILOG_FILE ../rtl/frontend_can/can_features.v
set_global_assignment -name VERILOG_FILE ../rtl/frontend_can/ips_flag.v
set_global_assignment -name VERILOG_FILE ../rtl/engine/sdp_ram.v
set_global_assignment -name VERILOG_FILE ../rtl/engine/tree_level.v
set_global_assignment -name VERILOG_FILE ../rtl/engine/rf_engine.v
set_global_assignment -name VERILOG_FILE ../rtl/engine/rf_classifier.v
set_global_assignment -name VERILOG_FILE ../rtl/update/crc32.v
set_global_assignment -name VERILOG_FILE ../rtl/update/spi_slave.v
set_global_assignment -name VERILOG_FILE ../rtl/update/cmd_decoder.v
set_global_assignment -name VERILOG_FILE ../rtl/update/blob_walker.v
set_global_assignment -name VERILOG_FILE ../rtl/update/blob_reader.v
set_global_assignment -name VERILOG_FILE ../rtl/update/update_core.v
set_global_assignment -name VERILOG_FILE ../rtl/nv/nv_ufm_avmm.v
set_global_assignment -name VERILOG_FILE ../rtl/nv/boot_rom.v
set_global_assignment -name VERILOG_FILE ../rtl/security/aes_sbox.v
set_global_assignment -name VERILOG_FILE ../rtl/security/aes128_enc.v
set_global_assignment -name VERILOG_FILE ../rtl/security/cmac_stream.v
set_global_assignment -name VERILOG_FILE ../rtl/security/ctr_stream.v
set_global_assignment -name QIP_FILE nv_flash/synthesis/nv_flash.qip

# This board's number and keys: keys/device_key.vh, made by
# python/make_device_key.py (keys/ is not in git). Without it the build stops.
set_global_assignment -name SEARCH_PATH ../keys
set_global_assignment -name MIF_FILE default_model.mif

# The .mif default needs a mode that stores memory contents in flash. UFM1 and
# UFM0 stay available (Step 0 in docs/RESULTS.md).
set_global_assignment -name INTERNAL_FLASH_UPDATE_MODE "SINGLE COMP IMAGE WITH ERAM"

# SPI update port: pulled up so it idles when the STM32 is unplugged.
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to GPIO[4]
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to GPIO[5]
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to GPIO[7]

set_global_assignment -name RESERVE_ALL_UNUSED_PINS_WEAK_PULLUP "AS INPUT TRI-STATED"
set_global_assignment -name NUM_PARALLEL_PROCESSORS ALL
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files

set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top